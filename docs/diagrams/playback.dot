digraph playback {
  graph [rankdir=LR, bgcolor="#F6F8FC", pad="0.3", nodesep="0.45", ranksep="0.55", fontname="Helvetica", fontsize=19, fontcolor="#142033", label="Per-bus CSV playback in the running app", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#CBD5E1", penwidth=1.4, fontname="Helvetica", fontsize=13, fontcolor="#142033", margin="0.18,0.13"];
  edge [color="#718096", arrowsize=0.8, fontname="Helvetica", fontsize=11, fontcolor="#475569"];
  csv [label="Validate and assign CSV\nGroup rows by source timestamp\n12 module slots per frame", fillcolor="#E1E9F9"];
  frames [label="Release one frame per second\nat default speed\nSource gaps do not set playback timing", fillcolor="#D6F2E9", color="#239B8E"];
  detector [label="Bus detection and history\nSource timestamps determine rise rate\nShow missing readings as unknown", fillcolor="#D6F2E9", color="#239B8E"];
  loop [label="Seamless loop\nReturn to first source frame\nKeep run, alerts and elapsed time\nClear trend windows", fillcolor="#E1E9F9"];
  inject [label="Optional API injection\nOne temporary in-memory event; CSV unchanged\nNot exposed in current utility UI", shape=note, fillcolor="#FFF7E6", color="#D6AA53"];
  csv -> frames -> detector -> loop;
  loop -> frames [label="repeat", constraint=false];
  inject -> detector [style=dashed];
}
